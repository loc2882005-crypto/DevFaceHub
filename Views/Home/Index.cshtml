@model IEnumerable<DevFaceHub.Models.Post>
@using Microsoft.AspNetCore.Identity
@inject UserManager<DevFaceHub.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Trang chủ - Bảng tin";
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? currentUser?.UserName ?? "bạn";
    // KHAI BÁO BIẾN currentUserId TẠI ĐÂY
    var currentUserId = currentUser?.Id;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <style>
            /* Tùy chỉnh màu sắc hover chuẩn Light Mode của Facebook */
            .fb-light-container {
                background-color: #FFFFFF;
                border-radius: 12px;
            }

            .fb-fake-input {
                background-color: #F0F2F5;
                border-radius: 999px;
                cursor: pointer;
                transition: 0.2s;
                color: #65676B;
            }

                .fb-fake-input:hover {
                    background-color: #E4E6EB;
                }

            .fb-action-btn {
                cursor: pointer;
                transition: 0.2s;
                border-radius: 8px;
                color: #65676B;
            }

                .fb-action-btn:hover {
                    background-color: #F0F2F5;
                }

            .fb-modal-content {
                background-color: #FFFFFF;
                color: #050505;
                border: none;
                box-shadow: 0 12px 28px 0 rgba(0,0,0,0.2), 0 2px 4px 0 rgba(0,0,0,0.1);
            }

            .fb-textarea:focus {
                background-color: #FFFFFF;
                color: #050505;
                outline: none;
                box-shadow: none;
            }

            .fb-textarea::placeholder {
                color: #65676B;
            }

            .fb-icon-live {
                color: #F3425F;
            }

            .fb-icon-photo {
                color: #45BD62;
            }

            .fb-icon-feeling {
                color: #F7B928;
            }

            .fb-border-light {
                border-color: #CED0D4 !important;
            }

            .fb-bg-gray {
                background-color: #E4E6EB;
            }

            /* --- THANH TƯƠNG TÁC (REACT ROW) --- */
            .fb-react-row {
                gap: 24px;
            }

            .fb-react-btn {
                background: transparent;
                border: none;
                color: #65676B;
                padding: 6px 12px;
                border-radius: 999px;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                cursor: pointer;
                outline: none;
            }

                .fb-react-btn:hover {
                    background-color: #F0F2F5;
                }

                .fb-react-btn i {
                    font-size: 20px;
                    line-height: 1;
                }

            .fb-react-count {
                font-size: 14px;
                font-weight: 600;
            }

            /* Trạng thái đã Thích */
            .fb-react-btn.fb-liked {
                color: #0866FF;
            }

            /* Mobile Responsive */
            @@media (max-width: 767.98px) {
                .fb-react-row

            {
                gap: 12px;
            }

            }
        </style>
        @if (User.Identity.IsAuthenticated)
        {
        <!-- Thanh trạng thái (Create Post Bar) - Light Mode -->
        <div class="card shadow-sm mb-4 border-0 fb-light-container px-2 py-1">
            <div class="card-body p-2">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <!-- Avatar -->
                    @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                    {
                        <img src="@currentUser.AvatarUrl" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="Avatar" />
                    }
                    else
                    {
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-dark fb-bg-gray" style="width: 40px; height: 40px; font-weight: bold;">
                            @(displayName?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                    }

                    <!-- Ô nhập giả (Pill) -->
                    <div class="flex-grow-1 fb-fake-input px-3 py-2 fw-normal" data-bs-toggle="modal" data-bs-target="#createPostModal">
                        Bạn đang nghĩ gì, @displayName?
                    </div>
                </div>

                <hr style="border-color: #CED0D4; margin: 8px 0;" />

                <!-- Nút tương tác (Icons) -->
                <div class="d-flex justify-content-between px-1">
                    <div class="fb-action-btn d-flex align-items-center gap-2 px-3 py-2 flex-grow-1 justify-content-center">
                        <i class="bi bi-camera-video-fill fs-5 fb-icon-live"></i>
                        <span class="fw-semibold d-none d-sm-inline">Video trực tiếp</span>
                    </div>
                    <div class="fb-action-btn d-flex align-items-center gap-2 px-3 py-2 flex-grow-1 justify-content-center" onclick="document.getElementById('imageInput').click();" data-bs-toggle="modal" data-bs-target="#createPostModal">
                        <i class="bi bi-images fs-5 fb-icon-photo"></i>
                        <span class="fw-semibold d-none d-sm-inline">Ảnh/video</span>
                    </div>
                    <div class="fb-action-btn d-flex align-items-center gap-2 px-3 py-2 flex-grow-1 justify-content-center">
                        <i class="bi bi-emoji-smile fs-5 fb-icon-feeling"></i>
                        <span class="fw-semibold d-none d-sm-inline">Cảm xúc/hoạt động</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Đăng Bài - Light Mode -->
        <div class="modal fade" id="createPostModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content fb-modal-content">
                    <div class="modal-header border-bottom-0 position-relative">
                        <h5 class="modal-title w-100 text-center fw-bold text-dark">Tạo bài viết</h5>
                        <!-- Nút Close màu xám chuẩn -->
                        <button type="button" class="btn-close position-absolute end-0 me-3 fb-bg-gray" data-bs-dismiss="modal" style="border-radius: 50%; padding: 0.6rem;"></button>
                    </div>
                    <div class="modal-body pt-0">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                            {
                                <img src="@currentUser.AvatarUrl" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-dark fb-bg-gray" style="width: 40px; height: 40px; font-weight: bold;">
                                    @(displayName?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                            }
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">@displayName</h6>
                                <span class="badge text-dark fb-bg-gray mt-1 fw-semibold"><i class="bi bi-people-fill me-1"></i>Bạn bè</span>
                            </div>
                        </div>

                        <!-- Form gửi lên Server -->
                        <form asp-action="CreatePost" method="post" enctype="multipart/form-data">
                            <textarea name="Content" class="form-control border-0 fb-textarea bg-transparent mb-2 text-dark" rows="4" placeholder="Bạn đang nghĩ gì, @displayName?" style="resize: none; font-size: 1.2rem;" required></textarea>

                            <!-- Khu vực xem trước ảnh -->
                            <div id="imagePreviewContainer" class="position-relative mb-3 d-none border rounded p-2 fb-border-light">
                                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" onclick="clearImage()" style="background-color: rgba(0,0,0,0.6); border-radius: 50%; z-index: 10; padding: 0.5rem;"></button>
                                <img id="imagePreview" src="#" class="img-fluid rounded w-100" style="max-height: 300px; object-fit: contain;" />
                            </div>

                            <!-- Add-ons cho bài viết -->
                            <div class="border rounded p-3 d-flex align-items-center justify-content-between mb-3 shadow-sm fb-border-light">
                                <span class="fw-semibold text-dark">Thêm vào bài viết của bạn</span>
                                <div class="d-flex gap-3">
                                    <i class="bi bi-images fs-5 fb-icon-photo" style="cursor: pointer;" onclick="document.getElementById('imageInput').click();"></i>
                                    <i class="bi bi-person-fill-add fs-5 text-primary" style="cursor: pointer;"></i>
                                    <i class="bi bi-emoji-smile fs-5 fb-icon-feeling" style="cursor: pointer;"></i>
                                    <i class="bi bi-geo-alt-fill fs-5 text-danger" style="cursor: pointer;"></i>
                                </div>
                            </div>

                            <input type="file" name="ImageFile" id="imageInput" class="d-none" accept="image/*" onchange="previewImage(this)" />
                            <button type="submit" class="btn w-100 fw-bold text-white shadow-none" style="background-color: #0D6EFD;">Đăng</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        }
        else
        {
            <div class="alert alert-info text-center mb-4">
                Vui lòng <a asp-controller="Account" asp-action="Login">Đăng nhập</a> để tham gia đăng bài và tương tác cùng mọi người!
            </div>
        }

        <!-- Khu vực hiển thị danh sách bài viết (News Feed) -->
        <h4 class="mb-3">Bảng tin mới nhất</h4>

        @if (!Model.Any())
        {
            <p class="text-muted text-center">Chưa có bài viết nào. Hãy là người đầu tiên đăng bài nhé!</p>
        }

        @foreach (var post in Model)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <!-- Thông tin người đăng -->
                    <!-- Thông tin người đăng & Menu Tùy chọn -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center">
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px; font-weight: bold;">
                                @(post.User?.FullName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <div>
                                <h6 class="mb-0">
                                    <a asp-controller="Profile" asp-action="Index" asp-route-id="@post.UserId" class="text-decoration-none text-dark hover-underline">
                                        @(post.User?.FullName ?? post.User?.UserName ?? "Người dùng ẩn danh")
                                    </a>
                                </h6>
                                <small class="text-muted">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>

                        <!-- Menu Ba chấm (Chỉ hiện nếu mình là chủ bài viết) -->
                        @if (post.UserId == currentUserId)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light text-muted rounded-circle border-0 shadow-none p-2 d-flex align-items-center justify-content-center" type="button" data-bs-toggle="dropdown" style="width: 35px; height: 35px;">
                                    <i class="bi bi-three-dots"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius: 8px;">
                                    <li>
                                        <!-- Form Xóa có kèm xác nhận bằng JavaScript -->
                                        <form asp-action="DeletePost" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này? Hành động này không thể hoàn tác.');">
                                            <input type="hidden" name="postId" value="@post.PostId" />
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 py-2">
                                                <i class="bi bi-trash3-fill"></i> Xóa bài viết
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <!-- Nút Sửa bài viết gọi Modal bằng JavaScript -->
                                        <button type="button" class="dropdown-item text-primary d-flex align-items-center gap-2 py-2 btn-edit-post"
                                                data-post-id="@post.PostId"
                                                data-post-content="@post.Content"
                                                data-post-image="@post.ImageUrl"
                                                data-bs-toggle="modal" data-bs-target="#editPostModal">
                                            <i class="bi bi-pencil-square"></i> Chỉnh sửa bài viết
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>

                    <!-- Nội dung bài viết -->
                    <p class="card-text">@post.Content</p>

                    <!-- Hình ảnh nếu có -->
                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <div class="mb-3">
                            <img src="@post.ImageUrl" class="img-fluid rounded" alt="Post image" style="max-height: 400px; width: 100%; object-fit: cover;" />
                        </div>
                    }

                    <hr />
                    <hr style="border-color: #CED0D4; margin: 12px 0;" />
                    <!-- Hàng Tương tác (Thích, Bình luận, Chia sẻ) -->
                    <div class="d-flex align-items-center fb-react-row mb-3">

                        @{
                            bool isLikedByMe = post.Likes.Any(l => l.UserId == currentUserId);
                        }

                        <!-- 1. Nút Thích -->
                        <button type="button" class="fb-react-btn btn-like @(isLikedByMe ? "fb-liked" : "")" data-post-id="@post.PostId" title="Thích">
                            <i class="bi @(isLikedByMe ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up") react-icon"></i>
                            <span class="fb-react-count like-count">@post.Likes.Count</span>
                        </button>

                        <!-- 2. Nút Bình luận (Giữ nguyên logic bật tắt Collapse) -->
                        <button type="button" class="fb-react-btn" data-bs-toggle="collapse" data-bs-target="#comments-@post.PostId" title="Bình luận">
                            <i class="bi bi-chat"></i>
                            <span class="fb-react-count">@post.Comments.Count</span>
                        </button>

                        <!-- 3. Nút Chia sẻ -->
                        @{
                            // GHI CHÚ: Chỉnh lại action "PostDetail" nếu sau này bạn làm trang chi tiết riêng cho từng bài viết.
                            var postUrl = Url.Action("Index", "Home", new { id = post.PostId }, Context.Request.Scheme);
                        }
                        <button type="button" class="fb-react-btn btn-share position-relative" data-post-url="@postUrl" title="Chia sẻ">
                            <i class="bi bi-share"></i>
                            <!-- GHI CHÚ: Thay số 0 bằng @@post.ShareCount nếu sau này Model Post có thêm trường ShareCount -->
                            <span class="fb-react-count">0</span>

                            <!-- Dòng chữ thông báo nhỏ ẩn đi, chỉ hiện khi bấm copy -->
                            <span class="share-toast text-success fw-bold d-none position-absolute" style="font-size: 11px; top: -20px; left: 50%; transform: translateX(-50%); white-space: nowrap;">Đã sao chép!</span>
                        </button>

                    </div>

                   

                    <!-- Khu vực danh sách bình luận và khung nhập bình luận (Ẩn/Hiện bằng Collapse) -->
                    <div class="collapse mt-2" id="comments-@post.PostId">
                        <div class="card card-body bg-light p-2">
                            <!-- Form gửi bình luận mới -->
                            @if (User.Identity.IsAuthenticated)
                            {
                                <form asp-action="AddComment" method="post" class="input-group mb-3">
                                    <input type="hidden" name="postId" value="@post.PostId" />
                                    <input type="text" name="commentContent" class="form-control form-control-sm" placeholder="Viết bình luận..." required />
                                    <button class="btn btn-outline-primary btn-sm" type="submit">Gửi</button>
                                </form>
                            }

                            <!-- Danh sách các bình luận hiện tại -->
                            @foreach (var comment in post.Comments)
                            {
                                <div class="border-bottom pb-1 mb-2">
                                    <div class="d-flex justify-content-between">
                                        <strong class="small">@(comment.User?.FullName ?? comment.User?.UserName ?? "Ẩn danh")</strong>
                                        <small class="text-muted" style="font-size: 11px;">@comment.CreatedAt.ToString("HH:mm dd/MM")</small>
                                    </div>
                                    <p class="mb-0 small text-dark">@comment.Content</p>
                                </div>
                            }
                            @if (!post.Comments.Any())
                            {
                                <small class="text-muted text-center">Chưa có bình luận nào.</small>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }

    </div>
</div>
<!-- Modal Chỉnh sửa Bài Viết -->
<div class="modal fade" id="editPostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content fb-modal-content">
            <div class="modal-header border-bottom-0 position-relative">
                <h5 class="modal-title w-100 text-center fw-bold text-dark">Chỉnh sửa bài viết</h5>
                <button type="button" class="btn-close position-absolute end-0 me-3 fb-bg-gray" data-bs-dismiss="modal" style="border-radius: 50%; padding: 0.6rem;"></button>
            </div>
            <div class="modal-body pt-0">
                <form asp-action="EditPost" method="post" enctype="multipart/form-data">
                    <!-- Input ẩn chứa ID bài viết -->
                    <input type="hidden" name="postId" id="editPostId" />

                    <textarea name="editContent" id="editPostContent" class="form-control border-0 fb-textarea bg-transparent mb-2 text-dark" rows="4" style="resize: none; font-size: 1.2rem;" required></textarea>

                    <!-- Khu vực xem trước ảnh hiện tại (hoặc ảnh mới) -->
                    <div id="editImagePreviewContainer" class="position-relative mb-3 border rounded p-2 fb-border-light d-none">
                        <img id="editImagePreview" src="#" class="img-fluid rounded w-100" style="max-height: 300px; object-fit: contain;" />
                    </div>

                    <div class="border rounded p-3 d-flex align-items-center justify-content-between mb-3 shadow-sm fb-border-light">
                        <span class="fw-semibold text-dark">Cập nhật ảnh bài viết</span>
                        <div class="d-flex gap-3">
                            <i class="bi bi-images fs-5 fb-icon-photo" style="cursor: pointer;" onclick="document.getElementById('editImageInput').click();"></i>
                        </div>
                    </div>

                    <input type="file" name="editImageFile" id="editImageInput" class="d-none" accept="image/*" onchange="previewEditImage(this)" />
                    <button type="submit" class="btn w-100 fw-bold text-white shadow-none" style="background-color: #0D6EFD;">Lưu thay đổi</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // 1. Script AJAX xử lý Thả Like (Đã cập nhật logic đổi Icon và Class)
        document.querySelectorAll('.btn-like').forEach(button => {
            button.addEventListener('click', async function () {
                const postId = this.getAttribute('data-post-id');
                const url = '/Home/ToggleLike';

                const formData = new FormData();
                formData.append('postId', postId);

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        const result = await response.json();

                        // Cập nhật số lượng
                        this.querySelector('.like-count').innerText = result.totalLikes;

                        // Cập nhật Icon và màu chữ dựa vào biến result.isLiked
                        const icon = this.querySelector('.react-icon');
                        if (result.isLiked) {
                            this.classList.add('fb-liked');
                            icon.classList.replace('bi-hand-thumbs-up', 'bi-hand-thumbs-up-fill');
                        } else {
                            this.classList.remove('fb-liked');
                            icon.classList.replace('bi-hand-thumbs-up-fill', 'bi-hand-thumbs-up');
                        }
                    } else if (response.status === 401 || response.status === 404) {
                        window.location.href = '/Account/Login';
                    }
                } catch (error) {
                    console.error('Lỗi kết nối:', error);
                }
            });
        });

        // 2. Logic xử lý nút Chia sẻ (Web Share API hoặc Copy Clipboard)
        document.querySelectorAll('.btn-share').forEach(button => {
            button.addEventListener('click', async function () {
                const url = this.getAttribute('data-post-url');
                const toast = this.querySelector('.share-toast');

                if (navigator.share) {
                    // Dùng Web Share API cho Mobile/Trình duyệt có hỗ trợ
                    try {
                        await navigator.share({
                            title: 'Xem bài viết này trên DevFaceHub',
                            url: url
                        });
                    } catch (err) {
                        console.log('Hủy chia sẻ hoặc lỗi:', err);
                    }
                } else {
                    // Fallback: Copy thẳng vào Clipboard đối với Desktop
                    try {
                        await navigator.clipboard.writeText(url);

                        // Hiển thị chữ "Đã sao chép" bay lên
                        toast.classList.remove('d-none');
                        setTimeout(() => {
                            toast.classList.add('d-none');
                        }, 2000);
                    } catch (err) {
                        console.error('Lỗi khi sao chép:', err);
                    }
                }
            });
        });

        // 3. Logic hiển thị ảnh xem trước Modal (Giữ nguyên)
        function previewImage(input) {
            const container = document.getElementById('imagePreviewContainer');
            const preview = document.getElementById('imagePreview');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    container.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                clearImage();
            }
        }

        // 4. Xóa ảnh đã chọn khi bấm nút X (Giữ nguyên)
        function clearImage() {
            document.getElementById('imageInput').value = '';
            document.getElementById('imagePreviewContainer').classList.add('d-none');
            document.getElementById('imagePreview').src = '#';
        }
    </script>
}